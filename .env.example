OPENAI_API_KEY=

# LLM_PROVIDER=claude のときだけ必要
ANTHROPIC_API_KEY=

# gpt-4o-transcribe       $0.006/分(約 $0.36/時)
# gpt-4o-mini-transcribe  $0.003/分(約 $0.18/時)
STT_MODEL=gpt-4o-transcribe

STT_LANGUAGE=ja

# 発話の区切り(意味の切れ目で判定)で、言いかけの続きをどれだけ待つか
# low(最長 8 秒) / medium(最長 4 秒) / high(最長 2 秒) / auto(medium と同じ)
STT_TURN_EAGERNESS=auto

# 音声認識セッションを張り替える間隔(ミリ秒)。サービス側のセッション時間の上限より短くする
STT_ROTATE_INTERVAL_MS=1500000

# 張り替え後、旧セッションの残りの確定結果を待つ時間(ミリ秒)
STT_ROTATE_GRACE_MS=5000

# 音声認識の接続エラー時に再接続を待つ時間(ミリ秒)。下限から始めて倍々に延ばし、上限で頭打ちにする
STT_RETRY_BASE_MS=1000
STT_RETRY_MAX_MS=30000

# 張り替えの時刻に、この時間(ミリ秒)以上音声が届いていなければ、張り替えずに接続を閉じる
STT_AUDIO_IDLE_MS=10000

# 音声認識への接続待ちの間に保持する音声の長さ(ミリ秒)。超えた分は古いものから捨てる
STT_PENDING_AUDIO_MS=10000

# 反論の読み上げに使う音声合成のモデル
# gpt-4o-mini-tts  $0.60/1Mトークン(入力) $12/1Mトークン(音声出力)。口調の指示(src/tts/prompts/voice-instructions.md)が効く
# tts-1            $15/1M文字。口調の指示は効かない
# tts-1-hd         $30/1M文字。口調の指示は効かない
TTS_MODEL=gpt-4o-mini-tts

# 読み上げの声
# alloy / ash / ballad / coral / echo / fable / nova / onyx / sage / shimmer / verse / marin / cedar
# 推奨: marin または cedar(公式が最高品質として挙げる。tts-1 / tts-1-hd では ballad / verse / marin / cedar は使えない)
TTS_VOICE=marin

# 読み上げの速さ(倍率)。0.25 以上 4.0 以下で、1.0 が等速
TTS_SPEED=1.3

# 反論の再生に合わせたハードウェア制御(サーボと効果音)
# on: 実機を動かす(I2C と GPIO が必要) / off: 何もせずに通過する(実機のない開発環境・コンテナ向け)
HARDWARE_CONTROL=off

# 応答しないクライアントを検出する間隔(ミリ秒)。1 周期の間に応答がなければ切断する
HEARTBEAT_INTERVAL_MS=15000

# 再生終了の報告が届かないとき、出力モードを打ち切って入力モードへ戻すまでの時間(ミリ秒)
OUTPUT_TIMEOUT_MS=60000

# 切断されたあと、ブラウザが再接続を試みるまでの時間(ミリ秒)
CLIENT_RECONNECT_DELAY_MS=2000

# ブラウザが音声を送る 1 回分の長さ(ミリ秒)
CLIENT_AUDIO_CHUNK_MS=100

# 会話履歴バッファの長さ(件)
# 推奨: HISTORY_BUFFER_SIZE=50(メモリ負荷は軽微。今後の連鎖制御で文脈をさかのぼる余裕を持たせる)
HISTORY_BUFFER_SIZE=50

# LLM リクエストに含める直近の件数(バッファの長さ以下)
# 推奨: LLM_HISTORY_CONTEXT_SIZE=10(文脈の把握に十分で、入力トークンを抑えられる)
LLM_HISTORY_CONTEXT_SIZE=10

# 一次フィルタに該当してから LLM リクエストを発行するまでの保留(ミリ秒)
# 新しい確定結果がこの時間届かなければ発行する(発話中は計らない)
# 推奨: LLM_REQUEST_IDLE_MS=2000(言いかけの続きや受け答えを取り込め、反論の遅れも小さい)
LLM_REQUEST_IDLE_MS=3000

# 確定結果が届き続けても、最初の該当からこの時間で打ち切って発行する(LLM_REQUEST_IDLE_MS より大きい値)
# 推奨: LLM_REQUEST_MAX_WAIT_MS=8000(会話が途切れなくても、話題が移る前に反論できる)
LLM_REQUEST_MAX_WAIT_MS=20000


# 判定・調査・反論構築に使う LLM のプロバイダ
# claude / openai
LLM_PROVIDER=openai

# LLM_PROVIDER=claude のときに使うモデル(そのときだけ必要)
# claude-opus-5-5    $4/1Mトークン(入力) $20/1Mトークン(出力)
# claude-sonnet-5-5  $2/1Mトークン(入力) $10/1Mトークン(出力)
LLM_CLAUDE_MODEL=

# LLM_PROVIDER=openai のときに使うモデル(そのときだけ必要)
# gpt-6-astra  $10/1Mトークン(入力)   $50/1Mトークン(出力)
# gpt-6.1-sol  $2/1Mトークン(入力)    $10/1Mトークン(出力)
# gpt-6-luna   $0.10/1Mトークン(入力) $0.50/1Mトークン(出力)
LLM_OPENAI_MODEL=gpt-6-luna

# 両プロバイダで共用する
# claude: low / medium / high / xhigh / max
# openai: none / minimal / low / medium / high / xhigh / max のうちモデルが対応する値(起動時には検証しない)
LLM_EFFORT=low

# 推奨: 16000(思考と検索結果の処理も上限に含まれるため、小さいと応答が途中で切れる。課金は実際の生成量のみ)
LLM_MAX_TOKENS=16000

# 1 リクエストあたりの Web 検索回数の上限
# 推奨: 3(根拠の確認には足り、応答速度と検索の費用を抑えられる)
LLM_WEB_SEARCH_MAX_USES=3