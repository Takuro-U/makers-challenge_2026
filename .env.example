OPENAI_API_KEY=

# LLM_PROVIDER=claude のときだけ必要
ANTHROPIC_API_KEY=

# gpt-4o-transcribe       $0.006/分(約 $0.36/時)
# gpt-4o-mini-transcribe  $0.003/分(約 $0.18/時)
STT_MODEL=gpt-4o-transcribe

STT_LANGUAGE=ja

# 会話履歴バッファの長さ(件)
# 推奨: HISTORY_BUFFER_SIZE=50(メモリ負荷は軽微。今後の連鎖制御で文脈をさかのぼる余裕を持たせる)
HISTORY_BUFFER_SIZE=

# LLM リクエストに含める直近の件数(バッファの長さ以下)
# 推奨: LLM_HISTORY_CONTEXT_SIZE=10(文脈の把握に十分で、入力トークンを抑えられる)
LLM_HISTORY_CONTEXT_SIZE=

# 一次フィルタに該当してから LLM リクエストを発行するまでの保留(ミリ秒)
# 新しい確定結果がこの時間届かなければ発行する(発話中は計らない)
# 推奨: LLM_REQUEST_IDLE_MS=2000(言いかけの続きや受け答えを取り込め、反論の遅れも小さい)
LLM_REQUEST_IDLE_MS=

# 確定結果が届き続けても、最初の該当からこの時間で打ち切って発行する(LLM_REQUEST_IDLE_MS より大きい値)
# 推奨: LLM_REQUEST_MAX_WAIT_MS=8000(会話が途切れなくても、話題が移る前に反論できる)
LLM_REQUEST_MAX_WAIT_MS=

# 判定・調査・反論構築に使う LLM のプロバイダ
# claude / openai
LLM_PROVIDER=

# LLM_PROVIDER=claude のときに使うモデル(そのときだけ必要)
# claude-opus-5-5    $4/1Mトークン(入力) $20/1Mトークン(出力)
# claude-sonnet-5-5  $2/1Mトークン(入力) $10/1Mトークン(出力)
LLM_CLAUDE_MODEL=

# LLM_PROVIDER=openai のときに使うモデル(そのときだけ必要)
# gpt-6-astra  $10/1Mトークン(入力)   $50/1Mトークン(出力)
# gpt-6.1-sol  $2/1Mトークン(入力)    $10/1Mトークン(出力)
# gpt-6-luna   $0.10/1Mトークン(入力) $0.50/1Mトークン(出力)
LLM_OPENAI_MODEL=

# 両プロバイダで共用する
# claude: low / medium / high / xhigh / max
# openai: none / minimal / low / medium / high / xhigh / max のうちモデルが対応する値(起動時には検証しない)
LLM_EFFORT=

# 推奨: 16000(思考と検索結果の処理も上限に含まれるため、小さいと応答が途中で切れる。課金は実際の生成量のみ)
LLM_MAX_TOKENS=

# 1 リクエストあたりの Web 検索回数の上限
# 推奨: 3(根拠の確認には足り、応答速度と検索の費用を抑えられる)
LLM_WEB_SEARCH_MAX_USES=
